 "content": "[{\"id\": \"5177d39114\", \"type\": \"header\", \"data\": {\"text\": \"<span class=\\\"h4\\\"><b>7. Projects &amp; Assets</b></span>\", \"col\": 12}}, {\"id\": \"8fdeb4dcac\", \"type\": \"paragraph\", \"data\": {\"text\": \"Assignment: projects and assets (docs/01 matrix 5.12-5.13: PJ-1..5, AS-1..6; diagram 4.3). Timesheet and milestone-task rules are enforced in <code>horizon_projects.projects</code>; asset maintenance and repairs feed the Asset Register with Maintenance.\", \"col\": 12}}, {\"id\": \"092b757c3a\", \"type\": \"paragraph\", \"data\": {\"text\": \"<b>Flow:</b> Sales Order → Project → Task → Timesheet → milestone Sales Invoice · Asset → Asset Maintenance → Asset Repair\", \"col\": 12}}, {\"id\": \"0b05a9a669\", \"type\": \"spacer\", \"data\": {\"col\": 12}}, {\"id\": \"bed801bfb4\", \"type\": \"header\", \"data\": {\"text\": \"<span class=\\\"h4\\\"><b>Shortcuts (process order)</b></span>\", \"col\": 12}}, {\"id\": \"baaf8ee666\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Project\", \"col\": 3}}, {\"id\": \"c304fa740e\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Task\", \"col\": 3}}, {\"id\": \"ecd77aa682\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Timesheet\", \"col\": 3}}, {\"id\": \"01f5051f25\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Asset\", \"col\": 3}}, {\"id\": \"a29b4a0ff5\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Asset Maintenance\", \"col\": 3}}, {\"id\": \"8376634d04\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Asset Repair\", \"col\": 3}}, {\"id\": \"669072094f\", \"type\": \"spacer\", \"data\": {\"col\": 12}}, {\"id\": \"965ee99beb\", \"type\": \"header\", \"data\": {\"text\": \"<span class=\\\"h4\\\"><b>Transactions, masters and reports</b></span>\", \"col\": 12}}, {\"id\": \"8085dc22f4\", \"type\": \"card\", \"data\": {\"card_name\": \"Transactions\", \"col\": 4}}, {\"id\": \"ffd2232c4f\", \"type\": \"card\", \"data\": {\"card_name\":