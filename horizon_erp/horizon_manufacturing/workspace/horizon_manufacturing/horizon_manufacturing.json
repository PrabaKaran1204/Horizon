 "content": "[{\"id\": \"9ceb33af6c\", \"type\": \"header\", \"data\": {\"text\": \"<span class=\\\"h4\\\"><b>6. Manufacturing</b></span>\", \"col\": 12}}, {\"id\": \"8ec258bd84\", \"type\": \"paragraph\", \"data\": {\"text\": \"Assignment: BOM and multi-level manufacturing, production planning and capacity (docs/01 matrix 5.9-5.10: BOM-1..5, PP-1..5; diagram 4.2). A Work Order is refused when it would push its line's booked machine hours past the workstation capacity.\", \"col\": 12}}, {\"id\": \"0c196e6674\", \"type\": \"paragraph\", \"data\": {\"text\": \"<b>Flow:</b> Sales Order → Production Plan → Work Order (capacity check) → Job Card + Quality Inspection → Production Audit → Finished Goods\", \"col\": 12}}, {\"id\": \"94ca49d98e\", \"type\": \"spacer\", \"data\": {\"col\": 12}}, {\"id\": \"9f4d514577\", \"type\": \"header\", \"data\": {\"text\": \"<span class=\\\"h4\\\"><b>Key figures</b></span>\", \"col\": 12}}, {\"id\": \"cfbaf7fb69\", \"type\": \"number_card\", \"data\": {\"number_card_name\": \"Work Orders In Progress\", \"col\": 4}}, {\"id\": \"02a8be9bee\", \"type\": \"number_card\", \"data\": {\"number_card_name\": \"Work Orders Overdue\", \"col\": 4}}, {\"id\": \"21d4473979\", \"type\": \"number_card\", \"data\": {\"number_card_name\": \"Line Utilisation Today %\", \"col\": 4}}, {\"id\": \"43501a8f8d\", \"type\": \"chart\", \"data\": {\"chart_name\": \"Work Orders by Status\", \"col\": 12}}, {\"id\": \"58cc0c0b33\", \"type\": \"spacer\", \"data\": {\"col\": 12}}, {\"id\": \"67cdce3827\", \"type\": \"header\", \"data\": {\"text\": \"<span class=\\\"h4\\\"><b>Shortcuts (process order)</b></span>\", \"col\": 12}}, {\"id\": \"8f595bf67c\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"BOM\", \"col\": 3}}, {\"id\": \"9fabd0f790\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Production Plan\", \"col\": 3}}, {\"id\": \"fcb246788e\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Work Order\", \"col\": 3}}, {\"id\": \"52d5edd9ff