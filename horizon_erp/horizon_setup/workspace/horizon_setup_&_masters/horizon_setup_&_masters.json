 "content": "[{\"id\": \"157805a5d2\", \"type\": \"header\", \"data\": {\"text\": \"<span class=\\\"h4\\\"><b>1. Setup &amp; Masters</b></span>\", \"col\": 12}}, {\"id\": \"9f1e6e0b28\", \"type\": \"paragraph\", \"data\": {\"text\": \"Assignment: multi-location structure, chart of accounts and cost centres, permission model (docs/01 sections 1-3 and matrix 5.1-5.2: MC-1..6, COA-1..6).\", \"col\": 12}}, {\"id\": \"ee98e42c81\", \"type\": \"paragraph\", \"data\": {\"text\": \"<b>Decision:</b> one company with two GSTINs; Mumbai HQ and Delhi DC are <b>Branches</b> (mandatory accounting dimension on every GL entry) instead of two companies, so inventory, masters and transfers stay in one company while each location still gets its own P&amp;L (ADR-1).\", \"col\": 12}}, {\"id\": \"5cd45cc973\", \"type\": \"paragraph\", \"data\": {\"text\": \"<b>Setup order:</b> Company → Branch / Accounting Dimension → Warehouse tree → Cost Center tree → Item, Customer, Supplier → Party Link → User Permission.\", \"col\": 12}}, {\"id\": \"13d92b20c6\", \"type\": \"spacer\", \"data\": {\"col\": 12}}, {\"id\": \"0862e83901\", \"type\": \"header\", \"data\": {\"text\": \"<span class=\\\"h4\\\"><b>Shortcuts (process order)</b></span>\", \"col\": 12}}, {\"id\": \"66bc9f8b85\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Company\", \"col\": 3}}, {\"id\": \"37febd53a8\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Branch\", \"col\": 3}}, {\"id\": \"0391a3d1c7\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Accounting Dimension\", \"col\": 3}}, {\"id\": \"3a8128a982\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Warehouse\", \"col\": 3}}, {\"id\": \"54d05f2ad6\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Cost Center\", \"col\": 3}}, {\"id\": \"ec10cff303\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Item\", \"col\": 3}}, {\"id\": \"ea7a73fec8\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Customer\", \"col\": 3}}, {\"id\": \"bcea9812e4\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Supplier\", \"col\": 3}}, {\"id\": \"0bca99b130\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Party Link\", \"col\": 3}}, {\"id\": \"099124887b\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"User Permission\", \"col\": 3}}, {\"id\": \"7cfa85ed6f\", \"type\": \"spacer\", \"data\": {\"col\": 12}}, {\"id\": \"9f7a9dc3c8\", \"type\": \"header\", \"data\": {\"text\": \"<span class=\\\"h4\\\"><b>Transactions, masters and reports</b></span>\", \"col\": 12}}, {\"id\": \"696e3b17f7\", \"type\": \"card\", \"data\": {\"card_name\": \"Masters\", \"col\": 4}}, {\"id\": \"4d0321cd9f\", \"type\": \"card\", \"data\": {\"card_name\": \"Parties and Items\", \"col\": 4}}, {\"id\": \"60df0e0194\", \"type\": \"card\", \"data\": {\"card_name\": \"Permissions\", \"col\": 4}}, {\"id\": \"5e0c3e71c4\", \"type\": \"card\", \"data\": {\"card_name\": \"Reports\", \"col\": 4}}]",
